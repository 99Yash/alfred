{
  // Scoped typecheck project for the package's whole `test/` tree — the
  // compile-only fixtures under `test/type` and the runnable `*.test.ts`
  // suites the `test` script executes. `check-types` runs this as a SECOND
  // `tsc` pass (after the composite `tsc -b`), because the composite build
  // emits declarations only for `src` and never sees `test/**`. Without this
  // pass the package's `test/` tree is checked by nothing.
  //
  // `include` covers `test` rather than `test/type` so that a file added
  // anywhere under `test/` is type-checked without an edit here. The runner
  // and this pass are both glob-derived and they overlap: no `.ts` under
  // `test/` is checked by neither.
  //
  // The base `tsconfig.json` is `composite: true`; a `tsc -p` invocation with
  // `noEmit` errors unless `composite`/`declaration` are overridden off here.
  // Nothing under `test/` is emitted or built — this project only
  // type-checks.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  // `exclude` is a BASELINE, not a policy. Every path below arrived here
  // already broken: all four files came from `packages/api/test/`, where they
  // sat in that package's baseline and so were checked by nothing, and they
  // carry their debt across with them rather than acquiring it here.
  // `packages/api` now carries no baseline of its own, so this list is the only
  // record of the debt those files owe. `pnpm check:test-typecheck-baseline`
  // derives this list from `tsc` and fails when it drifts in either direction,
  // so an entry cannot outlive its errors.
  "include": ["src", "test"],
  "exclude": [
    "test/replicache/resume-only.test.ts",
    "test/replicache/todos.test.ts",
    "test/replicache/triage-tags.test.ts",
    "test/workflows/revisions.test.ts"
  ]
}
