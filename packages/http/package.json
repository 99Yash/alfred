{
  "name": "@alfred/http",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "node ../../scripts/clean-package-dist.mjs && tsc -b --emitDeclarationOnly --force",
    "check-types": "tsc -b --emitDeclarationOnly && tsc -p tsconfig.test.json",
    "test": "tsx --test --test-force-exit \"test/**/*.test.ts\"",
    "test:db": "tsx --env-file-if-exists=../../apps/server/.env --test --test-force-exit \"test/**/*.test.ts\"",
    "test:env-free": "tsx --test --test-force-exit \"test/barrel-load.test.ts\""
  },
  "dependencies": {
    "@alfred/ai": "workspace:*",
    "@alfred/assistant": "workspace:*",
    "@alfred/auth": "workspace:*",
    "@alfred/contracts": "workspace:*",
    "@alfred/db": "workspace:*",
    "@alfred/env": "workspace:*",
    "@alfred/integrations": "workspace:*",
    "@alfred/sync": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "elysia": "catalog:",
    "ioredis": "catalog:",
    "jose": "^6.2.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@alfred/config": "workspace:*",
    "tsx": "^4.21.0"
  },
  "peerDependencies": {
    "typescript": "catalog:"
  }
}
