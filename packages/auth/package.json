{
  "name": "@alfred/auth",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "build": "node ../../scripts/clean-package-dist.mjs && tsc -b --emitDeclarationOnly --force",
    "check-types": "tsc -b --emitDeclarationOnly && tsc -p tsconfig.test.json",
    "test": "tsx --test --test-force-exit \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@alfred/contracts": "workspace:*",
    "@alfred/db": "workspace:*",
    "@alfred/env": "workspace:*",
    "better-auth": "catalog:",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@alfred/config": "workspace:*",
    "tsx": "^4.21.0"
  },
  "peerDependencies": {
    "typescript": "catalog:"
  }
}
