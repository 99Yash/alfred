    "@alfred/logging": "workspace:*",
    "@alfred/mailer": "workspace:*",
    "@alfred/sync": "workspace:*",
    "ai": "catalog:",
    "bullmq": "catalog:",
    "cron-parser": "^5.5.0",
    "drizzle-orm": "^0.45.2",
    "files-sdk": "^2.0.0",
    "ioredis": "catalog:",
    "resend": "catalog:",
    "sharp": "^0.35.2",
    "zod": "catalog:"
