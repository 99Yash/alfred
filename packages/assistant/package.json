    "./triggers": "./src/triggers/index.ts",
    "./settings": "./src/settings/index.ts",
    "./connections": "./src/connections/index.ts",
    "./artifacts": "./src/artifacts/index.ts",
    "./artifacts/*": "./src/artifacts/*",
    "./tool-runtime": "./src/tool-runtime/index.ts",
    "./tool-runtime/*": "./src/tool-runtime/*",
    "./execution": "./src/execution/index.ts",
    "./execution/*": "./src/execution/*.ts",
