    "./conversations": "./src/conversations/index.ts",
    "./conversations/*": "./src/conversations/*.ts",
    "./skills": "./src/skills/index.ts",
    "./skills/*": "./src/skills/*.ts",
    "./automation": "./src/automation/index.ts",
    "./automation/*": "./src/automation/*.ts"
  },
  "scripts": {
    "build": "node ../../scripts/clean-package-dist.mjs && tsc -b --emitDeclarationOnly --force",
