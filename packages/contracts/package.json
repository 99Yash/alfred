{
  "name": "@alfred/contracts",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./app-errors": "./src/app-errors/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "build": "node ../../scripts/clean-package-dist.mjs && tsc -b --emitDeclarationOnly --force",
    "check-types": "tsc -b --emitDeclarationOnly && tsc -p tsconfig.test.json",
    "test": "tsx --test --test-force-exit \"test/**/*.test.ts\""
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@alfred/config": "workspace:*",
    "tsx": "^4.19.2"
  },
  "peerDependencies": {
    "typescript": "catalog:"
  }
}
