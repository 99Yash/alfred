{
  // Scoped typecheck project for the package's whole `test/` tree. `check-types`
  // runs this as a SECOND `tsc` pass (after the composite `tsc -b`), because the
  // composite build emits declarations only for `src` and never sees `test/**`.
  //
  // `@alfred/sync` now has a `test` script and the `leaf-unit-tests` CI job runs
  // it, so this pass is no longer the only thing in the repo that reads `test/`.
  // It stays the only reader of `test/triage-tags.type-test.ts`, which the
  // runner glob `test/**/*.test.ts` deliberately does not match: that fixture
  // asserts nothing at runtime, so without this project a deliberate type error
  // appended to it left `pnpm check-types` at exit 0 for as long as the file
  // existed. `pnpm check:type-fixtures` now reports that shape instead of
  // leaving it to be found by eye.
  //
  // `include` covers `test` rather than `test/type` so that a file added
  // anywhere under `test/` is type-checked without an edit here.
  //
  // The base `tsconfig.json` is `composite: true`; a `tsc -p` invocation with
  // `noEmit` errors unless `composite`/`declaration` are overridden off here.
  // Nothing under `test/` is emitted or built — this project only type-checks.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["src", "test"]
}
