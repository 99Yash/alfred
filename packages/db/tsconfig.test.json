{
  // Scoped typecheck project for the package's whole `test/` tree, run by
  // `check-types` as a SECOND `tsc` pass after the composite `tsc -b` — the
  // composite build emits declarations for `src` only and never sees `test/**`.
  // Without this project the tree is checked by no `tsc` at all: `packages/db`
  // had no `test/` directory until the Redis connection-kind probes arrived,
  // so nothing here had ever been in a program.
  //
  // `include` covers `test` rather than any file list, so a file added anywhere
  // under `test/` is type-checked without an edit here.
  //
  // The base `tsconfig.json` is `composite: true`; a `tsc -p` invocation with
  // `noEmit` errors unless `composite`/`declaration` are overridden off here.
  // Nothing under `test/` is emitted or built — this project only type-checks.
  //
  // `exclude` is a BASELINE, not a policy. This tree arrived clean and acquired
  // its one entry by a MOVE: `test/credentials/credential-vault.test.ts` came
  // from `packages/api/test/`, where it already sat in that package's baseline,
  // and it carries its 18 diagnostics across rather than acquiring them here.
  // Every one is the same concept — the suite treats a `SealedCredentialSecret`
  // (an opaque branded symbol) as a plain `string`. Campaign item 100 owns that
  // repair; a move must not carry a possible behavior change with it.
  // `pnpm check:test-typecheck-baseline` derives this list from `tsc` and fails
  // when it drifts in either direction, so the entry cannot outlive its errors.
  // Paths are literal on purpose — the check rejects a glob, and a directory
  // glob would silently un-check every file added tomorrow.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["src", "test"],
  "exclude": ["test/credentials/credential-vault.test.ts"]
}
