{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Parsed as JSONC — comments are safe here (`pnpm format` does not touch this file).
  // Every `ignore*` entry below is a knip blind spot, not dead code. Verify before removing.
  //
  // Every duplicate export in this repo is intentional: react-email templates need a
  // `default` export for `@react-email/preview-server` alongside the named component
  // that `packages/mailer/src/index.ts` renders, and `observationPayloadSchema` /
  // `DEFAULT_GOOGLE_SCOPES` are deliberate semantic aliases. So the `duplicates` rule
  // only produces false positives here.
  "rules": {
    "duplicates": "off"
  },
  // An export tagged `@public` is intentional API that knip's static graph can't
  // see reaching — an Elysia route response type consumed only through Eden's
  // `typeof app` inference, for example. Tag such an export, don't un-export it.
  "tags": ["-public"],
  "ignore": [
    // Scratch/spike surfaces, kept deliberately unwired to the app.
    "scripts/spikes/**"
  ],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs", ".claude/hooks/*.mjs", ".agents/hooks/*.mjs"]
    },
    "apps/server": {
      "entry": ["src/scripts/**/*.ts", "evals/**/*.ts", "evalite.config.ts"],
      "ignoreDependencies": [
        // Bundle externals (see `external` in apps/server/tsdown.config.ts): a workspace
        // package in the server's graph imports these, tsdown leaves them out of the
        // bundle, so they must resolve from the server's own node_modules at runtime.
        // Knip does not read tsdown externals. The importer is named per entry where it
        // is not this app.
        "isomorphic-dompurify", // @alfred/assistant/triage/email-html
        "jsdom", // transitive: isomorphic-dompurify

        "sharp",
        "@alfred/mailer",
        // Needed for `"jsx": "react"` (apps/server/tsconfig.json) — the server
        // type-checks @alfred/mailer's .tsx sources to render emails server-side.
        "@types/react"
      ]
    },
    "apps/web": {
      "entry": ["test/**/*.test.{ts,tsx}"]
    },
    "packages/ai": {
      // Hand-run diagnostic/verification scripts (each documents its own tsx
      // invocation; see docs/decisions/ADR-0078 and the model-router plans).
      // Same category as apps/server and packages/api src/scripts — not dead.
      "entry": ["src/scripts/**/*.ts"]
    },
    "packages/api": {
      "entry": [
        "src/scripts/**/*.ts",
        "evals/**/*.ts",
        "evalite.config.ts",
        "test/**/*.test.ts"
      ],
      // Dormant by decision, not dead: ADR-0051 removed the boss `deepen` escalation
      // from triage v3, but the file stays for the historical decision trail and
      // `shouldDeepen` is still covered by test/triage/deepen.test.ts. See the NOTE in
      // src/modules/triage/index.ts and docs/reference/triage.md.
      "ignore": ["src/modules/triage/deepen.ts"],
      // evalite imports "vitest", "vitest/config" and "vitest/node" at runtime but
      // declares vitest as neither a dependency nor a peer. This devDependency is the
      // only thing satisfying it — dropping it breaks `pnpm --filter @alfred/api eval`.
      "ignoreDependencies": ["vitest"]
    },
    "packages/assistant": {
      "entry": ["src/scripts/**/*.ts", "evals/**/*.ts", "evalite.config.ts", "test/**/*.test.ts"],
      // Evalite loads Vitest at runtime but does not declare it as a dependency.
      "ignoreDependencies": ["vitest"]
    },
    "packages/sync": {
      "entry": ["test/**/*.{test,type-test}.ts"]
    },
    "packages/mailer": {
      // Each email is a preview-server entry: `@react-email/preview-server` renders the
      // file's `default` export, which no other module imports. Listing the emails as
      // entries stops knip from reporting those default exports as dead.
      "entry": ["src/emails/*.tsx"],
      "ignoreDependencies": ["@react-email/preview-server"]
    }
  }
}
