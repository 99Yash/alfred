    },
    {
      // no-unknown-returns stays off ON PURPOSE in the honest-boundary
      // file below. It is the canonical unknown-walker (contracts guards
      // getPath) whose contract IS an untyped value; narrowing belongs at
      // callers via a schema, per packages/contracts/AGENTS.md. Every other honest `unknown` return in
      // product source carries its own `oxlint-disable-next-line` with the
      // reason. A new open-`unknown` return anywhere else in product source
      // is an error.
      // oxlint-disarm: anti-slop/no-unknown-returns — each entry is a canonical unknown-walker whose contract IS an untyped value, so `unknown` is the honest return rather than an erased type.
      "files": ["packages/contracts/src/guards.ts"],
      "rules": {
        "anti-slop/no-unknown-returns": "off"
      }
    },
    {
      // no-console is at `error` for the web app's source, where a stray `console.log` reaches
      // every user's devtools. `console.error` and `console.warn` stay allowed: they report a
      // failure the UI also surfaces, and the web app has no logger to route them through.
      // The DEV-only chat timing trace (apps/web/src/lib/chat/timing.ts) prints through
      // `console.info` / `console.table` on purpose and carries its own directives. The rule
      // is off by default, so no other scope changes.
      "files": ["apps/web/src/**"],
      "rules": {
        "no-console": ["error", { "allow": ["error", "warn"] }]
      }
    },
    {
      // no-console is at `error` for server and package source: a log line goes through the pino
      // `logger` from `@alfred/logging`, whose `err` serializer drops free text and whose redact
      // paths censor credentials. `console` bypasses both. `@alfred/db` sits below the logger
      // (`@alfred/logging` imports it), so its four pool warnings keep `console` with a directive.
      "files": ["apps/server/src/**", "packages/*/src/**"],
      "rules": {
        "no-console": "error"
      }
    },
    {
      // Scripts print to the operator's terminal on purpose: `console` is their user interface.
      // The rule has no options, so `off` here exempts exactly this one concern.
      // oxlint-disarm: no-console — ops scripts report to the terminal of the operator who runs them, not to the server log.
      "files": ["apps/server/src/scripts/**", "packages/*/src/scripts/**"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      // no-unsafe-dictionary-type stays off ON PURPOSE in the honest-boundary
      // files below. Each carries dynamic dictionaries that are not debt per
      // the narrow-record-types decision table: the canonical guards and
      // rebuilds (contracts guards) and local boundary helpers
      // (extract-pdf-protocol). Every other honest open dictionary in product
      // source carries its own `oxlint-disable-next-line` with the reason. A
      // new open-dictionary spelling anywhere else in product source is an
      // error.
      // oxlint-disarm: anti-slop/no-unsafe-dictionary-type — each entry carries a dynamic dictionary that is not debt per the narrow-record-types decision table: a canonical guard or rebuild, or a local boundary helper.
      "files": [
        "packages/contracts/src/guards.ts",
        "packages/extraction/src/extract-pdf-protocol.ts"
      ],
      "rules": {
        "anti-slop/no-unsafe-dictionary-type": "off"
      }
    },
    {
      // The no-unsafe-* family stays off ON PURPOSE for JavaScript sources: the
      // repo-level gate scripts and hooks are JSDoc-typed `.mjs` checked with
      // `noImplicitAny: false` (scripts/tsconfig.json), so an unannotated
      // parameter or a parsed manifest is `any` by construction. The rules there
      // reported about 3,400 such reads on adoption, none of them an escaped
      // boundary. TypeScript sources everywhere, scripts/oxlint/** included,
      // keep the rules at `error`.
      // oxlint-disarm: typescript/no-unsafe-return — JSDoc-typed `.mjs` runs with noImplicitAny off, so `any` is the default type there, not an escaped boundary.
      // oxlint-disarm: typescript/no-unsafe-argument — JSDoc-typed `.mjs` runs with noImplicitAny off, so `any` is the default type there, not an escaped boundary.
      // oxlint-disarm: typescript/no-unsafe-call — JSDoc-typed `.mjs` runs with noImplicitAny off, so `any` is the default type there, not an escaped boundary.
      // oxlint-disarm: typescript/no-unsafe-member-access — JSDoc-typed `.mjs` runs with noImplicitAny off, so `any` is the default type there, not an escaped boundary.
      // oxlint-disarm: typescript/no-unsafe-assignment — JSDoc-typed `.mjs` runs with noImplicitAny off, so `any` is the default type there, not an escaped boundary.
      "files": ["**/*.mjs", "**/*.js", "**/*.cjs"],
      "rules": {
        "typescript/no-unsafe-return": "off",
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-assignment": "off"
      }
    }
  ]
}
