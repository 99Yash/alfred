{
  // Every fence in this repo lives in THIS file and nowhere else. oxlint resolves the nearest
  // config, so a second .oxlintrc.json anywhere below the root would replace this one for its whole
  // subtree and leave `pnpm lint` green. The three oxlint scripts therefore pin
  // `--config .oxlintrc.json`, which makes a nested config inert, and `pnpm check:oxlint-config`
  // reports both a stray config and a script that lost the pin. Narrow a rule with an "overrides"
  // entry below, never with a nested config file.
  "plugins": null,
  "jsPlugins": ["oxlint-tailwindcss"],
  "categories": {},
  "rules": {
    "tailwindcss/enforce-sort-order": ["warn", { "entryPoint": "apps/web/src/index.css" }],
    "tailwindcss/enforce-shorthand": "warn",
    "tailwindcss/no-deprecated-classes": ["warn", { "entryPoint": "apps/web/src/index.css" }],
    "typescript/no-restricted-types": [
      "error",
      {
        "types": {
          "Record<string, any>": {
            "message": "Record<string, any> defeats every `unknown` guard the contracts package exists to provide. Use a parsed schema, a Record<LiteralKey, T>, or a Map<K, V>."
          }
        }
      }
    ],
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["@alfred/assistant/knowledge/internal"],
            "message": "The knowledge internal tooling door is restricted to apps/server/src/scripts/** (see packages/assistant/src/knowledge/internal.ts). Import the sanctioned contract from @alfred/assistant/knowledge instead."
          },
          {
            "group": ["@alfred/integrations/google/internal"],
            "message": "The raw Gmail watch primitive is restricted to its two allowlisted friend files (see google/internal.ts). Install a watch through the api wrapper installGmailWatchAndSeedCursor, which also seeds the ingestion_state cursor; a raw installGmailWatch leaves the credential cursorless."
          }
        ]
      }
    ]
  },
  "settings": {
    "tailwindcss": {
      "entryPoint": "apps/web/src/index.css"
    },
    "jsx-a11y": {
      "polymorphicPropName": null,
      "components": {},
      "attributes": {}
    },
    "next": {
      "rootDir": []
    },
    "react": {
      "formComponents": [],
      "linkComponents": [],
      "version": null,
      "componentWrapperFunctions": []
    },
    "jsdoc": {
      "ignorePrivate": false,
      "ignoreInternal": false,
      "ignoreReplacesDocs": true,
      "overrideReplacesDocs": true,
      "augmentsExtendsReplacesDocs": false,
      "implementsReplacesDocs": false,
      "exemptDestructuredRootsFromChecks": false,
      "tagNamePreference": {}
    },
    "vitest": {
      "typecheck": false
    }
  },
  "env": {
    "builtin": true
  },
  "globals": {},
  "ignorePatterns": [],
  "overrides": [
    {
      "files": ["apps/server/src/scripts/**"],
      "rules": {
        // Deliberate omission: the @alfred/assistant/knowledge/internal group is absent on purpose — this
        // tree IS that door's allowlist. Every other root group must be restated here, because an override
        // REPLACES the rule's options wholesale. Item 47 asserts this list against the root one.
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@alfred/integrations/google/internal"],
                "message": "The raw Gmail watch primitive is restricted to its two allowlisted friend files (see google/internal.ts). Install a watch through the api wrapper installGmailWatchAndSeedCursor, which also seeds the ingestion_state cursor; a raw installGmailWatch leaves the credential cursorless."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "packages/assistant/src/connections/ingestion/gmail-ingest.ts",
        "packages/api/test/integrations/gmail-watch-gate.test.ts"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["packages/http/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@alfred/assistant/knowledge/internal"],
                "message": "The knowledge internal tooling door is restricted to apps/server/src/scripts/** (see packages/assistant/src/knowledge/internal.ts). Import the sanctioned contract from @alfred/assistant/knowledge instead."
              },
              {
                "group": ["@alfred/integrations/google/internal"],
                "message": "The raw Gmail watch primitive is restricted to its two allowlisted friend files (see google/internal.ts). Install a watch through the api wrapper installGmailWatchAndSeedCursor, which also seeds the ingestion_state cursor; a raw installGmailWatch leaves the credential cursorless."
              },
              {
                "group": [
                  "@alfred/http",
                  "@alfred/http/*",
                  "@alfred/http/**",
                  ".",
                  "./index*",
                  "..",
                  "../index*",
                  "../..",
                  "../../index*"
                ],
                "message": "packages/http/src may not import its own root barrel. `@alfred/http` and every relative spelling of src/index.ts resolve to the barrel that re-exports this file, so the import closes an `index.ts -> this file -> index.ts` module cycle. That cycle compiles, passes every gate and boots; it becomes a TDZ ReferenceError the day someone reorders the exports in index.ts. Import the concrete sibling module instead, e.g. `./middleware/auth`."
              }
            ]
          }
        ]
      }
    }
  ]
}
