{
  "plugins": null,
  "jsPlugins": ["oxlint-tailwindcss"],
  "categories": {},
  "rules": {
    "tailwindcss/enforce-sort-order": ["warn", { "entryPoint": "apps/web/src/index.css" }],
    "tailwindcss/enforce-shorthand": "warn",
    "tailwindcss/no-deprecated-classes": ["warn", { "entryPoint": "apps/web/src/index.css" }],
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["@alfred/api/modules/knowledge/internal"],
            "message": "The knowledge internal tooling door is restricted to apps/server/src/scripts/** (see knowledge/internal.ts). Import the sanctioned contract from @alfred/api/backend instead."
          }
        ]
      }
    ]
  },
  "settings": {
    "tailwindcss": {
      "entryPoint": "apps/web/src/index.css"
    },
    "jsx-a11y": {
      "polymorphicPropName": null,
      "components": {},
      "attributes": {}
    },
    "next": {
      "rootDir": []
    },
    "react": {
      "formComponents": [],
      "linkComponents": [],
      "version": null,
      "componentWrapperFunctions": []
    },
    "jsdoc": {
      "ignorePrivate": false,
      "ignoreInternal": false,
      "ignoreReplacesDocs": true,
      "overrideReplacesDocs": true,
      "augmentsExtendsReplacesDocs": false,
      "implementsReplacesDocs": false,
      "exemptDestructuredRootsFromChecks": false,
      "tagNamePreference": {}
    },
    "vitest": {
      "typecheck": false
    }
  },
  "env": {
    "builtin": true
  },
  "globals": {},
  "ignorePatterns": [],
  "overrides": [
    {
      "files": ["apps/server/src/scripts/**"],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
