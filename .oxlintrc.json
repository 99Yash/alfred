        ]
      }
    },
    {
      "files": ["packages/assistant/src/connections/ingestion/gmail-ingest.ts"],
      "rules": {
        // Deliberate omission: the @alfred/integrations/google/internal group is absent on purpose — this
        // file IS that door's allowlist. Every other root group must be restated here, because an override
        // REPLACES the rule's options wholesale. The characterization test that used to share this entry
        // moved into packages/integrations/test/ and now imports ../src/google/internal by relative path;
        // no-restricted-imports keys on the SPECIFIER, so a file inside the package it fences needs no
        // exemption. Every group below is byte-identical to the one it restates, so nothing was dropped
        // for the remaining file when the array shrank.
        // oxlint-omission: @alfred/integrations/google/internal — this file IS this door's allowlist.
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@alfred/assistant/knowledge/internal"],
                "message": "The knowledge internal tooling door is restricted to apps/server/src/scripts/** (see packages/assistant/src/knowledge/internal.ts). Import the sanctioned contract from @alfred/assistant/knowledge instead."
              },
              {
                "group": ["@alfred/assistant/connections/ingestion/internal"],
                "message": "The raw Gmail ingestion entry points are restricted to the operational scripts under apps/server/src/scripts/** and the ingestion-cursor test packages/assistant/test/gmail-ingest.test.ts (see packages/assistant/src/connections/ingestion/internal.ts). Import the sanctioned contract from @alfred/assistant/connections/ingestion instead, which drives ingestion through the BullMQ job that owns retry, burst dedup and the ingestion_state cursor."
              },
              {
                "group": ["@alfred/assistant/tool-runtime/internal/registry"],
                "message": "The global tool catalog is restricted to packages/assistant/src/tool-runtime/ (see packages/assistant/src/tool-runtime/internal/registry.ts, which owns the one mutable map). Import the sanctioned contract from @alfred/assistant/tool-runtime instead, whose index re-exports the catalog surface."
              },
              {
                "group": [
                  "@alfred/assistant/tool-runtime/internal/*",
                  "@alfred/assistant/tool-runtime/internal/**"
                ],
                "message": "Every module under packages/assistant/src/tool-runtime/internal/ is private to packages/assistant/src/tool-runtime/, not one door but the whole directory. Import the sanctioned contract from @alfred/assistant/tool-runtime instead, whose index publishes the runtime surface. The narrower @alfred/assistant/tool-runtime/internal/registry group above is deliberately kept beside this one: a specifier holding a glob is gated on package existence alone, so the literal registry specifier is the only one in this family that `pnpm check:oxlint-config` still resolves through the exports map to a git-listed file."
              }
            ]
          }
        ]
      }
    },
    {
      // The ingestion-cursor test drives seedGmailHistoryCursorIfAbsent directly, so this file IS the
      // @alfred/assistant/connections/ingestion/internal door's second allowlist beside the scripts glob.
      // It gets its own entry rather than joining the two friend files above, because that entry's
      // deliberate omission is the google door and this test has no use for a raw installGmailWatch
      // exemption. No file matches two entries: an override REPLACES the rule's options wholesale and the
      // last match wins, so an overlap would silently drop one entry's list.
      "files": ["packages/assistant/test/gmail-ingest.test.ts"],
      "rules": {
        // Deliberate omission: the @alfred/assistant/connections/ingestion/internal group is absent on
        // purpose — this file IS that door's allowlist. Every other root group must be restated here.
        // oxlint-omission: @alfred/assistant/connections/ingestion/internal — packages/assistant/test/gmail-ingest.test.ts IS this door's second allowlist.
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@alfred/assistant/knowledge/internal"],
                "message": "The knowledge internal tooling door is restricted to apps/server/src/scripts/** (see packages/assistant/src/knowledge/internal.ts). Import the sanctioned contract from @alfred/assistant/knowledge instead."
              },
              {
                "group": ["@alfred/integrations/google/internal"],
                "message": "The raw Gmail watch primitive is restricted to its one allowlisted friend file (see packages/integrations/src/google/internal.ts). Install a watch through installGmailWatchAndSeedCursor from @alfred/assistant/connections/ingestion, which also seeds the ingestion_state cursor; a raw installGmailWatch leaves the credential cursorless."
              },
              {
                "group": ["@alfred/assistant/tool-runtime/internal/registry"],
                "message": "The global tool catalog is restricted to packages/assistant/src/tool-runtime/ (see packages/assistant/src/tool-runtime/internal/registry.ts, which owns the one mutable map). Import the sanctioned contract from @alfred/assistant/tool-runtime instead, whose index re-exports the catalog surface."
              },
              {
                "group": [
                  "@alfred/assistant/tool-runtime/internal/*",
                  "@alfred/assistant/tool-runtime/internal/**"
                ],
                "message": "Every module under packages/assistant/src/tool-runtime/internal/ is private to packages/assistant/src/tool-runtime/, not one door but the whole directory. Import the sanctioned contract from @alfred/assistant/tool-runtime instead, whose index publishes the runtime surface. The narrower @alfred/assistant/tool-runtime/internal/registry group above is deliberately kept beside this one: a specifier holding a glob is gated on package existence alone, so the literal registry specifier is the only one in this family that `pnpm check:oxlint-config` still resolves through the exports map to a git-listed file."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/http/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@alfred/assistant/knowledge/internal"],
                "message": "The knowledge internal tooling door is restricted to apps/server/src/scripts/** (see packages/assistant/src/knowledge/internal.ts). Import the sanctioned contract from @alfred/assistant/knowledge instead."
              },
              {
                "group": ["@alfred/integrations/google/internal"],
                "message": "The raw Gmail watch primitive is restricted to its one allowlisted friend file (see packages/integrations/src/google/internal.ts). Install a watch through installGmailWatchAndSeedCursor from @alfred/assistant/connections/ingestion, which also seeds the ingestion_state cursor; a raw installGmailWatch leaves the credential cursorless."
              },
              {
                "group": ["@alfred/assistant/connections/ingestion/internal"],
                "message": "The raw Gmail ingestion entry points are restricted to the operational scripts under apps/server/src/scripts/** and the ingestion-cursor test packages/assistant/test/gmail-ingest.test.ts (see packages/assistant/src/connections/ingestion/internal.ts). Import the sanctioned contract from @alfred/assistant/connections/ingestion instead, which drives ingestion through the BullMQ job that owns retry, burst dedup and the ingestion_state cursor."
              },
              {
                "group": ["@alfred/assistant/tool-runtime/internal/registry"],
                "message": "The global tool catalog is restricted to packages/assistant/src/tool-runtime/ (see packages/assistant/src/tool-runtime/internal/registry.ts, which owns the one mutable map). Import the sanctioned contract from @alfred/assistant/tool-runtime instead, whose index re-exports the catalog surface."
              },
              {
                "group": [
                  "@alfred/assistant/tool-runtime/internal/*",
                  "@alfred/assistant/tool-runtime/internal/**"
                ],
                "message": "Every module under packages/assistant/src/tool-runtime/internal/ is private to packages/assistant/src/tool-runtime/, not one door but the whole directory. Import the sanctioned contract from @alfred/assistant/tool-runtime instead, whose index publishes the runtime surface. The narrower @alfred/assistant/tool-runtime/internal/registry group above is deliberately kept beside this one: a specifier holding a glob is gated on package existence alone, so the literal registry specifier is the only one in this family that `pnpm check:oxlint-config` still resolves through the exports map to a git-listed file."
              },
              {
                "group": [
                  "@alfred/http",
                  "@alfred/http/*",
                  "@alfred/http/**",
                  ".",
                  "./index*",
                  "..",
                  "../index*",
                  "../..",
                  "../../index*"
                ],
                "message": "packages/http/src may not import its own root barrel. `@alfred/http` and every relative spelling of src/index.ts resolve to the barrel that re-exports this file, so the import closes an `index.ts -> this file -> index.ts` module cycle. That cycle compiles, passes every gate and boots; it becomes a TDZ ReferenceError the day someone reorders the exports in index.ts. Import the concrete sibling module instead, e.g. `./middleware/auth`."
              }
            ]
          }
        ]
      }
    },
    {
      // Five files where no-known-value-widening is off ON PURPOSE — each holds a
      // widened type that is the honest contract, not discarded evidence:
      // - packages/contracts/src/json.ts: safeJsonParse erases to `unknown` by design;
      //   its catch arm returns a literal, which the rule rejects against any
      //   unknown-returning signature.
      // - packages/contracts/src/passthrough-bounds.ts: pruneToBudget is mutually
      //   recursive with fitChild, so the `unknown` annotation is mandatory, and its
      //   primitive overflow arm returns a template literal.
      // - packages/integrations/src/shared/rest-passthrough.ts: parseBody contains
      //   JSON.parse's `any` behind an explicit `unknown`; its arms return literals
      //   (null, the non-JSON marker) that the rule rejects at an unknown seam.
      // - packages/integrations/../attachments.ts (contracts): ingestPolicyByMime is
      //   the deliberately widened VIEW of the literal INGEST_POLICY table for
      //   open-ended MIME-type lookups; the literal stays the single source of truth.
      // - packages/assistant/src/connections/mcp/hash.ts: computeDescriptorHashes
      //   builds a `{ [remoteName]: hash }` record that is PERSISTED to a jsonb
      //   column; a Map would not serialize and the record type is the storage shape.
      // The bar for removing a file from this list is a change that keeps the
      // contract AND satisfies the rule — not a reworded cast.
      "files": [
        "packages/contracts/src/json.ts",
        "packages/contracts/src/passthrough-bounds.ts",
        "packages/contracts/src/attachments.ts",
        "packages/integrations/src/shared/rest-passthrough.ts",
        "packages/assistant/src/connections/mcp/hash.ts"
      ],
      "rules": {
        "anti-slop/no-known-value-widening": "off"
      }
    },
    {
      // require-safety-comment-for-type-assertion is at `error` for product source;
      // test, eval and test-support scopes are exempt ON PURPOSE. The rule asks an
      // assertion to name the invariant TypeScript cannot check, which is load-bearing
      // when a cast crosses a product seam. A fixture that casts a hand-built row or a
      // stubbed response to feed a seam has no unseen invariant to narrate — the cast IS
      // the fixture — so the rule there only extracts a repeated sentence. Product
      // source was driven to zero at warn before this promotion; see
      // docs/research/anti-slop-paydown-2026-09-12.md. Every glob below must keep
      // matching the surfaces the research measured (packages/*/test, packages/*/evals,
      // apps/*/evals, and *.test.*), or the rule silently returns to those trees.
      "files": [
        "**/test/**",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.test.mts",
        "**/*.test.cts",
        "**/evals/**",
        "**/*.eval.ts"
      ],
      "rules": {
        "anti-slop/require-safety-comment-for-type-assertion": "off"
      }
    },
    {
      // no-unsafe-dictionary-type is at `error` for product source; test, eval
      // and script scopes are exempt ON PURPOSE. The rule asks an open
      // dictionary to name its value contract, which is load-bearing when the
      // bag crosses a product seam. A fixture's capture buffer, an eval's mock
      // row, or a one-off probe's parsed-JSON bag has no unseen contract to
      // name — the bag IS the fixture — so the rule there only extracts
      // renames. Product source was driven to zero at warn before this
      // promotion; see docs/research/anti-slop-paydown-2026-09-12.md and
      // docs/research/narrow-record-types-2026-08-09.md. The `**/scripts/**`
      // glob covers both ops tooling (apps/server/src/scripts) and package
      // probes/smokes (packages/*/src/scripts): neither is typed product
      // code the rule exists to police.
      "files": [
        "**/test/**",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.test.mts",
        "**/*.test.cts",
        "**/evals/**",
        "**/*.eval.ts",
        "**/scripts/**"
      ],
      "rules": {
        "anti-slop/no-unsafe-dictionary-type": "off"
      }
    },
    {
      // no-unknown-returns is at `error` for product source; test, eval
      // and script scopes are exempt ON PURPOSE. A fixture's stubbed row or a
      // one-off probe's parsed-JSON bag has no named domain type to return —
      // the `unknown` IS the fixture — so the rule there only extracts
      // renames. See docs/research/anti-slop-paydown-2026-09-12.md.
      "files": [
        "**/test/**",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.test.mts",
        "**/*.test.cts",
        "**/evals/**",
        "**/*.eval.ts",
        "**/scripts/**"
      ],
      "rules": {
        "anti-slop/no-unknown-returns": "off"
      }
    },
    {
      // no-runtime-typeof is at `error` for product source; test, eval
      // and script scopes are exempt ON PURPOSE. A fixture's `typeof`
      // probe of a hand-built row, an eval's check of a stubbed response,
      // or a one-off script's probe of parsed JSON is not the unparsed-value
      // narrowing the rule exists to reject — the probe IS the fixture or
      // the probe. Product source was driven to zero at warn before this
      // promotion; see docs/research/anti-slop-paydown-2026-09-12.md.
      // The `**/scripts/**` glob covers both ops tooling
      // (apps/server/src/scripts) and package probes/smokes
      // (packages/*/src/scripts) plus repo-level scripts/: none is typed
      // product code the rule exists to police.
      "files": [
        "**/test/**",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.test.mts",
        "**/*.test.cts",
        "**/evals/**",
        "**/*.eval.ts",
        "**/scripts/**"
      ],
      "rules": {
        "anti-slop/no-runtime-typeof": "off"
      }
    },
    {
      // no-runtime-typeof stays off ON PURPOSE in the honest-boundary
      // files below. Each `typeof` there is the parse itself, a capability
      // probe, or a typed-union discrimination with no helper spelling —
      // not an unparsed value narrowed in place of a boundary decode:
      // - canonical unknown-walkers and serializers (contracts guards,
      //   sanitize, bound, flatten-json, tools stringifyCanonical, web
      //   eden restoreWireTimestamps, signature canonicalize,
      //   context-search deepFreeze, mcp client deepFreeze) dispatch on
      //   the runtime representation because the representation IS the
      //   contract being established;
      // - schema-boundary validators (contracts tool-schemas and
      //   tool-fields preprocessors, events z.custom, env server
      //   preprocessors, extraction protocol validators, triggers
      //   z.custom, replay-state preprocess, weather schemas transform)
      //   narrow `unknown` process.env, webhook, and model-output fields
      //   inside the Zod boundary that owns them;
      // - provider and external-payload readers (github-reducer,
      //   gmail-reducer, gmail-kind-fold, fact-policy content probes,
      //   hosted-endpoint parseUrl, github client, google oauth claims,
      //   mcp protocol TTL, discovery textFromContent, conversation
      //   transcript helpers, evidence asNumber, tool-call-card
      //   prettyJson, login-search sanitizeRedirect, briefings gather
      //   parseCoord, run-bottlenecks jsonb reason) narrow webhook,
      //   provider, and persisted-JSON fields at the ingestion edge;
      // - unknown renderers (approvals format stringValue and
      //   input-editor tool-input values, memory formatters, approval
