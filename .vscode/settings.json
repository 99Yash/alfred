{
  "editor.insertSpaces": true,
  "editor.tabSize": 2,
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "file",
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "oxc.fmt.experimental": true,
  "oxc.fmt.configPath": ".oxfmtrc.json",
  // VS Code merges this object across scopes, so a `source.organizeImports`
  // in the user settings still fires here. Nothing in this repo enforces import
  // order, so the action only re-sorts imports into diff noise on every save.
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit",
    "source.organizeImports": "never"
  },
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[javascript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  // Tailwind v4 has no JS config. Point the extension at the CSS entry that
  // holds `@import "tailwindcss"` and the `@theme inline` token map, so app
  // tokens (app-fg-4, app-bg-2, ...) complete too.
  "tailwindCSS.experimental.configFile": "apps/web/src/index.css",
  // Entries are regex. The trailing pattern covers the `*ClassName` pass-through
  // props (triggerClassName, overlayClassName, iconClassName, ...).
  "tailwindCSS.classAttributes": ["class", "className", ".*ClassName"],
  // `cn()` is the only class helper this repo uses (474 calls). Without this,
  // module-level `const X = cn("...")` gets no completions or lint.
  "tailwindCSS.classFunctions": ["cn"]
}
