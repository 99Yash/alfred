# warden
.warden/

# Local design recon dumps (screenshots, DOM/network captures).
# This is the home for scraped assets and captures — put them in references/,
# never at the repo root. `.railwayignore` and `.prettierignore` match.
references/
.scratch-*
.vsnap*

# Local design archive (snapshot only, never shipped)
archive/

# Local browser/chrome-devtools screenshots + scratch
apps/web/.screenshots/
.tmp-screens/
.tmp/

# Lessons system: personal durable lessons + ephemeral handoff docs.
# The machinery (.claude/skills, .claude/hooks) is shareable; the content is not.
.lessons/
.handoff/
.artifacts/
teaching/
.loop/

# Campaign workspace (/campaign skill): per-run queue state and extracted findings.
# The machinery (.claude/skills/campaign, scripts/campaign.sh) is tracked; the
# working state of a particular run is local.
.campaign/

# Teaching workspace (/teach skill) — local only
.teach/
.wayfinder/
# jscpd copy-paste detector output
.jscpd/

# Claude Code workspace: local by default, so personal skills/settings stay out.
# The un-ignored paths are the shareable machinery and ARE tracked — a new shared
# hook or skill needs its own `!` line here, or `git status` will never show it.
.claude/*
!.claude/hooks/
!.claude/skills/
.claude/skills/*
!.claude/skills/campaign/
!.claude/skills/handoff/
!.claude/skills/learn/
!.claude/skills/recall/
apps/web/.claude/skills/*
!apps/web/.claude/skills/react-doctor/