{
  "name": "alfred",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types && tsc -p scripts/tsconfig.json",
    "dev:web": "turbo run dev --filter=web",
    "dev:server": "turbo run dev --filter=server",
    "check:architecture": "node scripts/check-module-architecture.mjs",
    "check:web-boundaries": "node scripts/check-web-boundaries.mjs",
    "check:web-bundle-graph": "node scripts/check-web-bundle-graph.mjs",
    "check:exports": "node scripts/check-package-exports.mjs",
    "check:type-fixtures": "node scripts/check-type-fixture-programs.mjs",
    "check:test-typecheck-baseline": "node scripts/check-test-typecheck-baseline.mjs",
    "check:imports": "node scripts/relative-to-alias.mjs --check",
    "check:consolidation": "node scripts/check-consolidation-drift.mjs",
    "check:doc-symbols": "node scripts/check-doc-symbols.mjs",
    "check:prose-locators": "node scripts/check-prose-locators.mjs",
    "check:script-paths": "node scripts/check-script-paths.mjs",
    "check:test-id-prefixes": "node scripts/check-test-id-prefixes.mjs",
    "check:campaign-state": "node scripts/campaign-state.selftest.mjs",
    "check:duplicates": "jscpd apps packages --threshold 1 --reporters console",
    "check:oxlint-config": "node scripts/check-oxlint-config.mjs",
    "lint": "oxlint --config .oxlintrc.json",
    "lint:fix": "oxlint --config .oxlintrc.json --fix --fix-suggestions",
    "lint:fix:all": "oxlint --config .oxlintrc.json --fix-dangerously",
    "db:studio": "turbo run db:studio --filter=@alfred/db",
    "db:generate": "turbo run db:generate --filter=@alfred/db",
    "db:migrate": "turbo run db:migrate --filter=@alfred/db",
    "db:encrypt-credentials": "pnpm --filter @alfred/db db:encrypt-credentials",
    "db:encrypt-credentials:check": "pnpm --filter @alfred/db db:encrypt-credentials:check",
    "db:sync-prices": "turbo run db:sync-prices --filter=@alfred/db",
    "db:predeploy": "pnpm --filter @alfred/db db:migrate && pnpm --filter @alfred/db db:sync-prices",
    "format": "oxfmt --write --ignore-path .gitignore --ignore-path .prettierignore apps packages scripts package.json pnpm-workspace.yaml turbo.json .oxlintrc.json .oxfmtrc.json",
    "format:check": "oxfmt --check --ignore-path .gitignore --ignore-path .prettierignore apps packages scripts package.json pnpm-workspace.yaml turbo.json .oxlintrc.json .oxfmtrc.json",
    "check": "pnpm check:script-paths && pnpm check:test-id-prefixes && pnpm check:architecture && pnpm check:web-boundaries && pnpm check:exports && pnpm check:type-fixtures && pnpm check:test-typecheck-baseline && pnpm check:imports && pnpm check:consolidation && pnpm check:doc-symbols && pnpm check:prose-locators && pnpm check:campaign-state && pnpm check:duplicates && pnpm check:oxlint-config && pnpm lint && pnpm format:check",
    "test:deterministic": "pnpm -r --no-bail --filter=!@alfred/db test",
    "verify:fast": "pnpm check && pnpm check-types",
    "verify": "pnpm verify:fast && pnpm test:deterministic",
    "verify:db": "pnpm db:migrate && pnpm -r --no-bail --workspace-concurrency=1 test:db",
    "doctor": "pnpm exec react-doctor",
    "dup": "jscpd apps packages",
    "dup:report": "jscpd apps packages --reporters json,html",
    "knip": "knip"
  },
  "devDependencies": {
    "@types/node": "^22.13.11",
    "jscpd": "^5.0.12",
    "knip": "^6.27.0",
    "oxfmt": "^0.26.0",
    "oxlint": "^1.62.0",
    "oxlint-tailwindcss": "^1.3.3",
    "react-doctor": "^0.2.10",
    "turbo": "^2.8.10",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.7.0"
}
